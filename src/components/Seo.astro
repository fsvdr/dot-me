---
import { SITE, shareThumbnail } from '../consts';

interface Og {
  type?: 'website' | 'article';
  published_time?: string | Date;
  section?: string;
  tag?: string[];
}

interface Props {
  lang?: string;
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  imageAlt?: string;
  locale?: 'en_US' | 'es_MX';
  author?: string;
  og?: Og;
}

const defaultImage = shareThumbnail({
  title: 'I make websites and apps',
  circle: `Based in Mexico City ·${new Date().getFullYear()}·`,
  badge: 'Own it',
});

const {
  lang = 'en',
  title = '',
  description = '',
  canonical = '',
  image = defaultImage,
  imageAlt = 'Reads: I make websites and apps. Based in Mexico City. Own it.',
  locale = 'en_US',
  author = SITE.author,
  og = { type: 'website' },
} = Astro.props;

const siteUrl = (Astro.site?.href ?? SITE.url).replace(/\/$/, '');
const resolvedTitle = title || SITE.title;
const resolvedDescription = description || SITE.description;
const canonicalUrl = `${siteUrl}${canonical}`;
const imageUrl = `${siteUrl}${image}`;
---

<title>{resolvedTitle}</title>
<meta name="description" content={resolvedDescription} />
<link rel="canonical" href={canonicalUrl} />

<meta property="og:type" content={og.type || 'website'} />
<meta property="og:site_name" content="FSVDR" />
<meta property="og:title" content={resolvedTitle} />
<meta property="og:description" content={resolvedDescription} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:locale" content={locale} />
{locale === 'en_US' && <meta property="og:locale:alternate" content="es_MX" />}
{locale === 'es_MX' && <meta property="og:locale:alternate" content="en_US" />}
{og.type === 'article' && og.published_time && (
  <meta property="article:published_time" content={new Date(og.published_time).toISOString()} />
)}
{og.type === 'article' && <meta property="article:author" content={author} />}
{og.type === 'article' && og.section && <meta property="og:section" content={og.section} />}
{og.type === 'article' && og.tag && og.tag.map((t) => <meta property="og:tag" content={t} />)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@fsvdr" />
<meta name="twitter:creator" content={author} />
<meta name="twitter:title" content={resolvedTitle} />
<meta name="twitter:description" content={resolvedDescription} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={imageAlt} />

<meta name="lang" content={lang} />
