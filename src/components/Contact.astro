---
import { Image } from 'astro:assets';
import Title from './Title.astro';
import SectionAnchor from './SectionAnchor.astro';
import GhostText from './GhostText.astro';
import computer from '../assets/computer.jpg';
---

<section class="section contact" id="contact">
  <div class="wrapper">
    <Title as="h2" size="xl" tabindex="0">
      <SectionAnchor />
      Got a project? <br />
      Get in touch! <br />
      No commitments. <br />
      No hidden fees. <br />
      All chill.
    </Title>

    <address class="email" aria-label="Email address">
      <GhostText aria-hidden="true">dev@fsvdr.me</GhostText>
      <span class="highlight">dev@fsvdr.me</span>
      <GhostText aria-hidden="true">dev@fsvdr.me</GhostText>
    </address>

    <p>
      I'm currently available for freelance projects — and even if you just want to talk about business ideas, tech or
      life itself drop me a line!
    </p>

    <div class="figure parallax">
      <Image src={computer} alt="" widths={[300, 500]} sizes="(min-width: 768px) 46rem, 50vw" />
    </div>
  </div>
</section>

<style>
  .contact {
    padding-block-start: 6rem;
    padding-block-end: 6rem;
    overflow: unset;
  }

  .contact .wrapper {
    position: relative;
    width: 100%;
  }

  .contact .wrapper > :global(.title) {
    font-size: min(12vw, var(--font-size-xl));
  }

  @media screen and (min-width: 768px) {
    .contact {
      padding-block-start: 8rem;
      padding-block-end: 10rem;
    }
  }

  .figure {
    position: absolute;
    top: 20%;
    right: -2vw;
    inline-size: max(50vw, 26rem);
    max-inline-size: 46rem;
    z-index: -1;
    opacity: 0.6;
    --parallax-from: -5%;
    --parallax-to: 5%;
  }

  .figure :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .email {
    display: flex;
    flex-flow: column nowrap;
    font-size: var(--font-size-lg);
    font-style: normal;
    font-weight: var(--font-weight-black);
    text-transform: uppercase;
    margin-block-start: 8rem;
    margin-block-end: 8rem;
  }

  .email .highlight {
    margin-block-end: 0;
    margin-inline-start: 4rem;
  }

  .email :global(span:last-child) {
    margin-inline-start: 8rem;
  }
</style>
