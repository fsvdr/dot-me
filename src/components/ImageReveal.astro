---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  widths?: number[];
  sizes?: string;
  loading?: 'eager' | 'lazy';
}

const { src, alt, widths = [400, 800, 1200], sizes = '(min-width: 768px) 46rem, 90vw', loading = 'lazy' } = Astro.props;
---

<div class="image-reveal">
  <Image src={src} alt={alt} widths={widths} sizes={sizes} loading={loading} />
</div>

<style>
  .image-reveal {
    clip-path: inset(0 0 0 0);
  }

  .image-reveal :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (prefers-reduced-motion: no-preference) {
    .image-reveal {
      animation: image-reveal 0.6s ease-in-out both;
    }

    @keyframes image-reveal {
      from {
        clip-path: inset(0 0 100% 0);
      }
      to {
        clip-path: inset(0 0 0 0);
      }
    }
  }
</style>
